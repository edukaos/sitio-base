---
// Bloque: buscador de propiedades. Se ubica debajo de la portada y lleva a /propiedades con los filtros elegidos.
import { nombresOperacion, nombresTipo, valoresUnicos } from '../../lib/propiedades';

interface Props { ancla?: string; titulo?: string }
const { ancla = 'buscar', titulo = '¿Qué estás buscando?' } = Astro.props;
const operaciones = valoresUnicos('operacion');
const tipos = valoresUnicos('tipo');
const barrios = valoresUnicos('barrio');
const campo = 'w-full rounded-tema border border-borde bg-fondo px-3 py-3 text-texto outline-none focus:border-primario focus:ring-2 focus:ring-primario/20';
---
{operaciones.length > 0 && (
  <section id={ancla} class="relative z-10 -mt-10 px-5 sm:px-8">
    <form action="/propiedades" method="get" class="tarjeta mx-auto grid max-w-5xl gap-3 p-5 md:grid-cols-[1fr_1fr_1fr_auto] md:items-end">
      <p class="font-titulos text-lg font-bold text-texto md:col-span-4">{titulo}</p>
      <select name="operacion" class={campo} aria-label="Operación">
        <option value="">Comprar o alquilar</option>
        {operaciones.map((o) => <option value={o}>{nombresOperacion[o] ?? o}</option>)}
      </select>
      <select name="tipo" class={campo} aria-label="Tipo de propiedad">
        <option value="">Tipo de propiedad</option>
        {tipos.map((t) => <option value={t}>{nombresTipo[t] ?? t}</option>)}
      </select>
      <select name="barrio" class={campo} aria-label="Barrio">
        <option value="">Barrio</option>
        {barrios.map((b) => <option value={b}>{b}</option>)}
      </select>
      <button type="submit" class="rounded-tema bg-primario px-8 py-3 font-semibold text-sobre-primario transition-colors hover:bg-primario-oscuro">Buscar</button>
    </form>
  </section>
)}

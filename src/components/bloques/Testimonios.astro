---
import Encabezado from '../Encabezado.astro';

interface Item { texto?: string; nombre?: string; cargo?: string }
interface Props { ancla?: string; etiqueta?: string; titulo?: string; subtitulo?: string; items?: Item[] }
const { ancla = 'testimonios', etiqueta, titulo, subtitulo, items = [] } = Astro.props;
const iniciales = (n = '') => n.split(' ').filter(Boolean).slice(0, 2).map((p) => p[0]).join('').toUpperCase();
---
<section id={ancla} class="py-20 md:py-28">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <Encabezado etiqueta={etiqueta} titulo={titulo} subtitulo={subtitulo} />
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {items.map((item) => (
        <figure class="tarjeta flex flex-col p-7">
          <svg class="h-8 w-8 text-acento" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M9.6 6C6.5 7.3 4.5 10 4.5 13.4c0 2.6 1.6 4.6 3.9 4.6 2 0 3.4-1.4 3.4-3.3 0-1.8-1.3-3.1-3-3.1-.3 0-.7 0-.9.1.4-1.7 2-3.3 3.6-4.1L9.6 6Zm9 0c-3.1 1.3-5.1 4-5.1 7.4 0 2.6 1.6 4.6 3.9 4.6 2 0 3.4-1.4 3.4-3.3 0-1.8-1.3-3.1-3-3.1-.3 0-.7 0-.9.1.4-1.7 2-3.3 3.6-4.1L18.6 6Z"/></svg>
          <blockquote class="mt-4 flex-1 text-texto">{item.texto}</blockquote>
          <figcaption class="mt-6 flex items-center gap-3">
            <span class="flex h-11 w-11 items-center justify-center rounded-full bg-primario/10 font-semibold text-primario">{iniciales(item.nombre)}</span>
            <span>
              <span class="block font-semibold text-texto">{item.nombre}</span>
              {item.cargo && <span class="block text-sm text-suave">{item.cargo}</span>}
            </span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

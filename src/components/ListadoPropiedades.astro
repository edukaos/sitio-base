---
import TarjetaPropiedad from './TarjetaPropiedad.astro';
import { propiedades, nombresOperacion, nombresTipo, valoresUnicos } from '../lib/propiedades';

const operaciones = valoresUnicos('operacion');
const tipos = valoresUnicos('tipo');
const barrios = valoresUnicos('barrio');
const campo = 'w-full rounded-tema border border-borde bg-fondo px-3 py-2.5 text-sm text-texto outline-none focus:border-primario focus:ring-2 focus:ring-primario/20';
---
<section class="bg-superficie">
  <div class="mx-auto max-w-6xl px-5 pb-10 pt-14 sm:px-8">
    <h1 class="text-3xl font-bold text-texto sm:text-4xl">Propiedades</h1>
    <p class="mt-2 text-suave">Encontrá tu próximo hogar o inversión.</p>

    <form id="filtros" class="tarjeta mt-8 grid gap-3 p-4 sm:grid-cols-2 lg:grid-cols-5" onsubmit="return false">
      <label class="block">
        <span class="mb-1 block text-xs font-semibold uppercase tracking-wide text-suave">Operación</span>
        <select name="operacion" class={campo}>
          <option value="">Todas</option>
          {operaciones.map((o) => <option value={o}>{nombresOperacion[o] ?? o}</option>)}
        </select>
      </label>
      <label class="block">
        <span class="mb-1 block text-xs font-semibold uppercase tracking-wide text-suave">Tipo</span>
        <select name="tipo" class={campo}>
          <option value="">Todos</option>
          {tipos.map((t) => <option value={t}>{nombresTipo[t] ?? t}</option>)}
        </select>
      </label>
      <label class="block">
        <span class="mb-1 block text-xs font-semibold uppercase tracking-wide text-suave">Barrio</span>
        <select name="barrio" class={campo}>
          <option value="">Todos</option>
          {barrios.map((b) => <option value={b}>{b}</option>)}
        </select>
      </label>
      <label class="block">
        <span class="mb-1 block text-xs font-semibold uppercase tracking-wide text-suave">Ambientes</span>
        <select name="ambientes" class={campo}>
          <option value="">Cualquiera</option>
          <option value="1">1 o más</option>
          <option value="2">2 o más</option>
          <option value="3">3 o más</option>
          <option value="4">4 o más</option>
        </select>
      </label>
      <label class="block">
        <span class="mb-1 block text-xs font-semibold uppercase tracking-wide text-suave">Ordenar</span>
        <select name="orden" class={campo}>
          <option value="">Destacadas</option>
          <option value="menor">Menor precio</option>
          <option value="mayor">Mayor precio</option>
        </select>
      </label>
    </form>
  </div>
</section>

<section class="py-12">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <p id="contador" class="mb-6 text-sm text-suave">{propiedades.length} propiedades</p>
    <div id="grilla" class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {propiedades.map((p) => <TarjetaPropiedad propiedad={p} />)}
    </div>
    <div id="vacio" class="hidden py-20 text-center">
      <p class="text-lg font-semibold text-texto">No encontramos propiedades con esos filtros.</p>
      <button type="button" id="limpiar" class="mt-4 font-semibold text-primario underline">Ver todas</button>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('filtros') as HTMLFormElement;
  const grilla = document.getElementById('grilla')!;
  const contador = document.getElementById('contador')!;
  const vacio = document.getElementById('vacio')!;
  const tarjetas = Array.from(grilla.querySelectorAll<HTMLElement>('[data-propiedad]'));
  const ordenOriginal = [...tarjetas];

  // Si la URL trae filtros (ej. /propiedades?operacion=alquiler), los aplica
  const params = new URLSearchParams(location.search);
  for (const [clave, valor] of params) {
    const campo = form.elements.namedItem(clave) as HTMLSelectElement | null;
    if (campo) campo.value = valor;
  }

  function aplicar() {
    const f = new FormData(form);
    const op = f.get('operacion') as string;
    const tipo = f.get('tipo') as string;
    const barrio = f.get('barrio') as string;
    const amb = Number(f.get('ambientes') || 0);
    const orden = f.get('orden') as string;

    let visibles = 0;
    for (const t of tarjetas) {
      const d = t.dataset;
      const ok =
        (!op || d.operacion === op) &&
        (!tipo || d.tipo === tipo) &&
        (!barrio || d.barrio === barrio) &&
        (!amb || Number(d.ambientes) >= amb);
      t.style.display = ok ? '' : 'none';
      if (ok) visibles++;
    }

    const lista = orden
      ? [...tarjetas].sort((a, b) => {
          const pa = Number(a.dataset.precio) || Infinity;
          const pb = Number(b.dataset.precio) || Infinity;
          return orden === 'menor' ? pa - pb : (pb === Infinity ? -1 : pb) - (pa === Infinity ? -1 : pa);
        })
      : ordenOriginal;
    lista.forEach((t) => grilla.appendChild(t));

    contador.textContent = `${visibles} ${visibles === 1 ? 'propiedad' : 'propiedades'}`;
    vacio.classList.toggle('hidden', visibles > 0);
  }

  form.addEventListener('change', aplicar);
  document.getElementById('limpiar')!.addEventListener('click', () => {
    form.reset();
    aplicar();
  });
  aplicar();
</script>

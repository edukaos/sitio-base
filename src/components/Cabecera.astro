---
import { sitio, enlaceWhatsapp } from '../lib/datos';
import Icono from './Icono.astro';
const menu = (sitio.menu ?? []).filter((m) => m.texto && m.enlace);
const wa = enlaceWhatsapp(sitio.contacto?.whatsapp, sitio.contacto?.mensajeWhatsapp);
const ctaEnlace = wa || '/#contacto';
---
<header class="sticky top-0 z-40 border-b border-borde bg-fondo/90 backdrop-blur">
  <div class="mx-auto flex h-18 max-w-6xl items-center justify-between gap-4 px-5 sm:px-8">
    <a href="/" class="flex items-center gap-3" aria-label={`${sitio.nombre}, inicio`}>
      {sitio.logo ? (
        <img src={sitio.logo} alt={sitio.nombre} class="h-10 w-auto" />
      ) : (
        <span class="font-titulos text-xl font-bold text-primario">{sitio.nombre}</span>
      )}
    </a>

    <nav class="hidden items-center gap-8 md:flex" aria-label="Principal">
      {menu.map((m) => (
        <a href={m.enlace} class="text-sm font-medium text-suave transition-colors hover:text-primario">{m.texto}</a>
      ))}
      <a href={ctaEnlace} target={wa ? '_blank' : undefined} rel={wa ? 'noopener' : undefined}
        class="rounded-tema bg-primario px-5 py-2.5 text-sm font-semibold text-sobre-primario transition-colors hover:bg-primario-oscuro">
        Contactanos
      </a>
    </nav>

    <!-- Menú móvil sin JavaScript -->
    <details class="group relative md:hidden">
      <summary class="flex cursor-pointer list-none items-center rounded-tema p-2 text-texto [&::-webkit-details-marker]:hidden" aria-label="Abrir menú">
        <svg class="h-6 w-6 group-open:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
        <svg class="hidden h-6 w-6 group-open:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg>
      </summary>
      <div class="tarjeta absolute right-0 mt-3 w-64 p-3">
        {menu.map((m) => (
          <a href={m.enlace} class="block rounded-tema px-3 py-2.5 font-medium text-texto hover:bg-superficie">{m.texto}</a>
        ))}
        <a href={ctaEnlace} class="mt-2 flex items-center justify-center gap-2 rounded-tema bg-primario px-3 py-2.5 font-semibold text-sobre-primario">
          <Icono nombre="chat" class="h-4 w-4" /> Contactanos
        </a>
      </div>
    </details>
  </div>
</header>

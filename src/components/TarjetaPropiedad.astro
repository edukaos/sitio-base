---
import Icono from './Icono.astro';
import { type Propiedad, formatoPrecio, nombresOperacion, nombresTipo } from '../lib/propiedades';

interface Props { propiedad: Propiedad }
const { propiedad: p } = Astro.props;
const foto = p.fotos?.[0];
const etiquetaEstado = p.estado === 'reservada' ? 'Reservada' : p.estado === 'vendida' ? (p.operacion === 'venta' ? 'Vendida' : 'Alquilada') : '';
---
<a
  href={`/propiedades/${p.slug}`}
  class="tarjeta group flex flex-col overflow-hidden transition-transform hover:-translate-y-1"
  data-propiedad
  data-operacion={p.operacion}
  data-tipo={p.tipo}
  data-barrio={p.barrio ?? ''}
  data-ambientes={p.ambientes ?? 0}
  data-precio={p.precio ?? 0}
  data-moneda={p.moneda ?? 'USD'}
>
  <div class="relative aspect-[4/3] overflow-hidden bg-superficie">
    {foto ? (
      <img src={foto} alt={p.titulo} loading="lazy" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" />
    ) : (
      <div class="flex h-full w-full items-center justify-center bg-linear-to-br from-primario/15 to-acento/25 text-primario/60">
        <Icono nombre="casa" class="h-16 w-16" />
      </div>
    )}
    <div class="absolute left-3 top-3 flex gap-2">
      <span class="rounded-tema bg-primario px-2.5 py-1 text-xs font-semibold text-sobre-primario">{nombresOperacion[p.operacion] ?? p.operacion}</span>
      {p.destacada && !etiquetaEstado && <span class="rounded-tema bg-acento px-2.5 py-1 text-xs font-semibold text-white">Destacada</span>}
      {etiquetaEstado && <span class="rounded-tema bg-texto px-2.5 py-1 text-xs font-semibold text-white">{etiquetaEstado}</span>}
    </div>
  </div>
  <div class="flex flex-1 flex-col p-5">
    <p class="font-titulos text-2xl font-bold text-primario">{formatoPrecio(p)}</p>
    <h3 class="mt-1 font-semibold text-texto">{p.titulo}</h3>
    <p class="mt-1 flex items-center gap-1.5 text-sm text-suave">
      <Icono nombre="ubicacion" class="h-4 w-4" />{[nombresTipo[p.tipo] ?? p.tipo, p.barrio].filter(Boolean).join(' · ')}
    </p>
    <div class="mt-auto flex flex-wrap gap-x-4 gap-y-1 border-t border-borde pt-4 text-sm text-suave">
      {!!p.superficieTotal && <span><strong class="text-texto">{p.superficieTotal}</strong> m²</span>}
      {!!p.ambientes && <span><strong class="text-texto">{p.ambientes}</strong> amb.</span>}
      {!!p.dormitorios && <span><strong class="text-texto">{p.dormitorios}</strong> dorm.</span>}
      {!!p.banos && <span><strong class="text-texto">{p.banos}</strong> {p.banos === 1 ? 'baño' : 'baños'}</span>}
    </div>
  </div>
</a>
